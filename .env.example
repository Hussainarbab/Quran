# Core app configuration
EXPO_PUBLIC_APP_NAME=Noor-e-Hidayat
EXPO_PUBLIC_APP_DISPLAY_NAME=Noor-e-Hidayat | Shia Islamic Library
EXPO_PUBLIC_APP_SLUG=noor-e-hidayat
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_APP_ENVIRONMENT=development
EXPO_PUBLIC_DEFAULT_LOCALE=en
EXPO_PUBLIC_DEFAULT_TIMEZONE=Asia/Karachi
EXPO_PUBLIC_APP_TAGLINE=Shia Islamic Library
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
EXPO_PUBLIC_ISSUES_URL=https://github.com/your-org/quran/issues

# Supabase configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=library-assets

# Content and API settings
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_API_TIMEOUT_MS=15000
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
EXPO_PUBLIC_ENABLE_SYNC=true
EXPO_PUBLIC_VERIFICATION_MODE=required
EXPO_PUBLIC_CONTENT_SOURCE_MODE=verified
EXPO_PUBLIC_QURAN_SOURCE_EDITION=Standard verified edition
EXPO_PUBLIC_CALENDAR_PROVIDER=local-estimated
EXPO_PUBLIC_MOON_SIGHTING_SOURCE=regional-authority

# Feature flags
EXPO_PUBLIC_ENABLE_DARK_MODE=true
EXPO_PUBLIC_ENABLE_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_TASBEEH=true
EXPO_PUBLIC_ENABLE_OFFLINE_DOWNLOADS=true
EXPO_PUBLIC_ENABLE_SEARCH=true
EXPO_PUBLIC_ENABLE_ADMIN_PANEL=false
EXPO_PUBLIC_ENABLE_ANALYTICS=false

# Monitoring and deployment
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APPLE_APP_ID=
EXPO_PUBLIC_GOOGLE_PLAY_PACKAGE=
EXPO_PUBLIC_APP_REVIEW_URL=

# Optional platform integrations
EXPO_PUBLIC_PAYMENTS_ENABLED=false
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_REMOTE_CONFIG_URL=
EXPO_PUBLIC_AUTH_PROVIDER=supabase
